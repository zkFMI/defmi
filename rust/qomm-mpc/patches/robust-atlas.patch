+/*
+ * RobustDecode.h
+ *
+ * Berlekamp-Welch over a Shamir codeword: recover the secret AND name the
+ * senders whose shares do not lie on it.
+ *
+ * `MaliciousShamirMC::locate` answers only the second half of that question,
+ * because it is called after a consistency check has already failed and the
+ * caller is about to throw. A robust protocol needs both halves and needs them
+ * on the common path, so the honest case is a single interpolation and the
+ * linear system is only built once a share is known to disagree.
+ */
+
+#ifndef PROTOCOLS_ROBUSTDECODE_H_
+#define PROTOCOLS_ROBUSTDECODE_H_
+
+#include <vector>
+using namespace std;
+
+/// Lagrange interpolation at `at` through the `degree + 1` positions in `idx`.
+template<class F>
+F rd_interpolate(const vector<F>& shares, const vector<F>& x,
+        const vector<int>& idx, int degree, const F& at)
+{
+    F acc = F(0);
+    for (int a = 0; a <= degree; a++)
+    {
+        F term = shares[idx[a]];
+        for (int b = 0; b <= degree; b++)
+        {
+            if (b == a)
+                continue;
+            term *= (at - x[idx[b]]) / (x[idx[a]] - x[idx[b]]);
+        }
+        acc += term;
+    }
+    return acc;
+}
+
+/// Decode `shares` as an RS[n, degree+1] codeword evaluated at 1..n.
+///
+/// On success `value` is the secret --- the polynomial at zero --- `culprits`
+/// holds the positions that disagree with it, and the return is true. The
+/// return is false when more than floor((n - degree - 1) / 2) shares are wrong,
+/// which is the point past which no algorithm can tell one candidate codeword
+/// from another. Refusing there is correct behaviour: naming somebody past
+/// capacity would be worse than saying nothing.
+template<class F>
+bool robust_decode(const vector<F>& shares, int degree, F& value,
+        vector<int>& culprits)
+{
+    int n = shares.size();
+    int capacity = (n - degree - 1) / 2;
+    culprits.clear();
+    if (n < degree + 1)
+        return false;
+
+    vector<F> x(n);
+    for (int i = 0; i < n; i++)
+        x[i] = F(i + 1);              // Shamir evaluates player i at i+1
+
+    // The honest path, which is almost every path: interpolate through the
+    // first degree+1 and check that the rest lie on it. One interpolation.
+    {
+        vector<int> idx(degree + 1);
+        for (int a = 0; a <= degree; a++)
+            idx[a] = a;
+        bool agrees = true;
+        for (int i = degree + 1; i < n and agrees; i++)
+            if (rd_interpolate(shares, x, idx, degree, x[i]) != shares[i])
+                agrees = false;
+        if (agrees)
+        {
+            value = rd_interpolate(shares, x, idx, degree, F(0));
+            return true;
+        }
+    }
+
+    if (capacity < 1)
+        return false;
+
+    // Berlekamp-Welch. Solve for Q of degree <= degree+e and monic E of degree
+    // e with Q(x_i) = y_i E(x_i); E then vanishes on the wrong positions. `e`
+    // is tried upwards so one liar costs the smallest system that can find one.
+    for (int e = 1; e <= capacity; e++)
+    {
+        int cols = (degree + e + 1) + e;
+        if (cols > n)
+            break;
+        vector<vector<F>> m(n, vector<F>(cols + 1));
+        for (int i = 0; i < n; i++)
+        {
+            F xk = F(1);
+            for (int k = 0; k < degree + e + 1; k++)
+            {
+                m[i][k] = xk;
+                xk *= x[i];
+            }
+            F xp = F(1);
+            for (int k = 0; k < e; k++)
+            {
+                m[i][degree + e + 1 + k] = F(0) - shares[i] * xp;
+                xp *= x[i];
+            }
+            m[i][cols] = shares[i] * xp;          // xp is now x^e
+        }
+
+        // reduced row echelon form; free variables take zero, which is a
+        // particular solution and is all that is needed
+        vector<int> pivot;
+        int r = 0;
+        for (int c = 0; c < cols and r < n; c++)
+        {
+            int p = -1;
+            for (int i = r; i < n; i++)
+                if (not m[i][c].is_zero())
+                {
+                    p = i;
+                    break;
+                }
+            if (p < 0)
+                continue;
+            swap(m[r], m[p]);
+            F scale = m[r][c].invert();
+            for (int k = c; k <= cols; k++)
+                m[r][k] *= scale;
+            for (int i = 0; i < n; i++)
+                if (i != r and not m[i][c].is_zero())
+                {
+                    F f = m[i][c];
+                    for (int k = c; k <= cols; k++)
+                        m[i][k] -= f * m[r][k];
+                }
+            pivot.push_back(c);
+            r++;
+        }
+        bool consistent = true;
+        for (int i = r; i < n and consistent; i++)
+        {
+            bool all_zero = true;
+            for (int c = 0; c < cols; c++)
+                if (not m[i][c].is_zero())
+                    all_zero = false;
+            if (all_zero and not m[i][cols].is_zero())
+                consistent = false;
+        }
+        if (not consistent)
+            continue;
+        vector<F> sol(cols, F(0));
+        for (size_t i = 0; i < pivot.size(); i++)
+            sol[pivot[i]] = m[i][cols];
+
+        // the positions E does not vanish on are the ones worth interpolating
+        // from
+        vector<int> good;
+        for (int i = 0; i < n; i++)
+        {
+            F ev = F(0), xp = F(1);
+            for (int k = 0; k < e; k++)
+            {
+                ev += sol[degree + e + 1 + k] * xp;
+                xp *= x[i];
+            }
+            ev += xp;                             // the monic top term
+            if (not ev.is_zero())
+                good.push_back(i);
+        }
+        if ((int) good.size() < degree + 1)
+            continue;
+
+        // Interpolate from degree+1 trusted positions and see who disagrees.
+        // Reading the roots of E instead would be wrong: when e overshoots, E
+        // picks up roots that belong to nobody, and a share that does lie on
+        // the polynomial is not evidence against its sender.
+        vector<int> idx(good.begin(), good.begin() + degree + 1);
+        vector<int> disagree;
+        for (int i = 0; i < n; i++)
+            if (rd_interpolate(shares, x, idx, degree, x[i]) != shares[i])
+                disagree.push_back(i);
+        if ((int) disagree.size() <= capacity)
+        {
+            culprits = disagree;
+            value = rd_interpolate(shares, x, idx, degree, F(0));
+            return true;
+        }
+    }
+    return false;
+}
+
+#endif /* PROTOCOLS_ROBUSTDECODE_H_ */
