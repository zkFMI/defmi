+template<class T>
+vector<int> MaliciousShamirMC<T>::locate(const vector<open_type>& shares,
+        int degree)
+{
+    // Berlekamp-Welch. Solve for Q of degree <= degree+e and monic E of degree
+    // e with Q(x_i) = y_i E(x_i); then E vanishes on the liars. `e` is tried
+    // upwards, so an honest opening never reaches here and a single liar costs
+    // the smallest system that can find one.
+    typedef typename T::open_type F;
+    int n = shares.size();
+    int capacity = (n - degree - 1) / 2;
+    vector<F> x(n);
+    for (int i = 0; i < n; i++)
+        x[i] = F(i + 1);            // Shamir<T> evaluates player i at i+1
+
+    for (int e = 1; e <= capacity; e++)
+    {
+        int cols = (degree + e + 1) + e;
+        if (cols > n)
+            break;
+        vector<vector<F>> m(n, vector<F>(cols + 1));
+        for (int i = 0; i < n; i++)
+        {
+            F xk = F(1);
+            for (int k = 0; k < degree + e + 1; k++)
+            {
+                m[i][k] = xk;
+                xk *= x[i];
+            }
+            F xp = F(1);
+            for (int k = 0; k < e; k++)
+            {
+                m[i][degree + e + 1 + k] = F(0) - shares[i] * xp;
+                xp *= x[i];
+            }
+            m[i][cols] = shares[i] * xp;      // xp is now x^e
+        }
+
+        // reduced row echelon form; free variables take zero, which is a
+        // particular solution and is all that is needed
+        vector<int> pivot;
+        int r = 0;
+        for (int c = 0; c < cols && r < n; c++)
+        {
+            int p = -1;
+            for (int i = r; i < n; i++)
+                if (not m[i][c].is_zero())
+                {
+                    p = i;
+                    break;
+                }
+            if (p < 0)
+                continue;
+            swap(m[r], m[p]);
+            F scale = m[r][c].invert();
+            for (int k = c; k <= cols; k++)
+                m[r][k] *= scale;
+            for (int i = 0; i < n; i++)
+                if (i != r and not m[i][c].is_zero())
+                {
+                    F f = m[i][c];
+                    for (int k = c; k <= cols; k++)
+                        m[i][k] -= f * m[r][k];
+                }
+            pivot.push_back(c);
+            r++;
+        }
+        bool consistent = true;
+        for (int i = r; i < n and consistent; i++)
+        {
+            bool all_zero = true;
+            for (int c = 0; c < cols; c++)
+                if (not m[i][c].is_zero())
+                    all_zero = false;
+            if (all_zero and not m[i][cols].is_zero())
+                consistent = false;
+        }
+        if (not consistent)
+            continue;
+        vector<F> sol(cols, F(0));
+        for (size_t i = 0; i < pivot.size(); i++)
+            sol[pivot[i]] = m[i][cols];
+
+        // E is monic of degree e; the parties it does not vanish on are the
+        // ones whose shares can be trusted to interpolate from
+        vector<int> good;
+        for (int i = 0; i < n; i++)
+        {
+            F ev = F(1), xp = F(1);          // ev = E(x_i)
+            ev = F(0);
+            for (int k = 0; k < e; k++)
+            {
+                ev += sol[degree + e + 1 + k] * xp;
+                xp *= x[i];
+            }
+            ev += xp;                        // the monic top term
+            if (not ev.is_zero())
+                good.push_back(i);
+        }
+        if ((int) good.size() < degree + 1)
+            continue;
+
+        // interpolate from degree+1 trusted shares and see who disagrees. Doing
+        // it this way rather than reading the roots of E is deliberate: when e
+        // overshoots, E picks up roots that belong to nobody, and a share that
+        // does lie on the polynomial is not evidence against its sender.
+        vector<int> culprits;
+        for (int i = 0; i < n; i++)
+        {
+            F fit = F(0);
+            for (int a = 0; a <= degree; a++)
+            {
+                int ia = good[a];
+                F term = shares[ia];
+                for (int b = 0; b <= degree; b++)
+                {
+                    if (b == a)
+                        continue;
+                    int ib = good[b];
+                    term *= (x[i] - x[ib]) / (x[ia] - x[ib]);
+                }
+                fit += term;
+            }
+            if (fit != shares[i])
+                culprits.push_back(i);
+        }
+        if ((int) culprits.size() <= capacity)
+            return culprits;
+    }
+    return vector<int>();
+}
+
 #endif
