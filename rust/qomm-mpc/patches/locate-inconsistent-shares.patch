 template<class T>
+void MaliciousShamirMC<T>::exchange(const Player& P)
+{
+    // ShamirMC::exchange is a PARTIAL broadcast: with this->threshold set to
+    // 2t it makes every party a sender to the 2t+1 nearest and nothing more,
+    // which is exactly enough to reconstruct a degree-2t sharing and exactly
+    // one short of enough to locate two liars in a degree-t one. Locating needs
+    // the whole codeword, so this sends to everybody.
+    //
+    // It is not free. Each party went from four correspondents to six, so an
+    // opening costs 50% more, and `artifacts/decode_patch.json` measures what
+    // that is on a real circuit.
+    vector<bool> everyone(P.num_players(), true);
+    P.partial_broadcast(everyone, everyone, *this->os);
