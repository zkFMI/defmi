+// Null unless an embedder registers it, which no stock build does. Offered the
+// machine while it is still alive, so a caller can read what the run cost
+// without parsing what the run printed. A callback avoids platform-specific
+// treatment of undefined weak symbols in otherwise ordinary party binaries.
+using QommAfterRun = void (*)(const BaseMachine*);
+inline QommAfterRun& qomm_after_run_callback()
+{
+    static QommAfterRun callback = nullptr;
+    return callback;
+}
